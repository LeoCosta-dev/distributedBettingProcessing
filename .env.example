# Application

APP_ENV=local
APP_NAME=distributedBettingProcessing
HTTP_ADDR=:8080

# PostgreSQL

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=wagering
POSTGRES_USER=wagering
POSTGRES_PASSWORD=wagering

DATABASE_URL=postgres://wagering:wagering@postgres:5432/wagering?sslmode=disable

# AWS / LocalStack

AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

SQS_WAGER_QUEUE=wager-transactions.fifo
SQS_WAGER_DLQ=wager-transactions-dlq.fifo
SQS_EVENT_QUEUE=wager-events.fifo

# Keycloak

KEYCLOAK_BASE_URL=http://keycloak:8080
KEYCLOAK_REALM=wagering
KEYCLOAK_ISSUER_URL=http://localhost:8082/realms/wagering
KEYCLOAK_HOSTNAME=http://localhost:8082

# Test identities provisioned by infra/keycloak/wagering-realm.json.
# Local development only; the application never stores or issues credentials.
KEYCLOAK_TEST_PASSWORD=dev-only-pass

# OAuth/OIDC

OAUTH_CLIENT_ID=wagering-api
OAUTH_CLIENT_SECRET=change-me

# Token validation
# The issuer must match the iss claim byte for byte; the JWKS endpoint may be
# reached through an internal address that the issuer does not expose.
OIDC_ISSUER=http://localhost:8082/realms/wagering
OIDC_JWKS_URL=http://keycloak:8080/realms/wagering/protocol/openid-connect/certs
OAUTH_AUDIENCE=wagering-api

# HTTP lifecycle

HTTP_SHUTDOWN_TIMEOUT=10s

# Workers

SQS_VISIBILITY_TIMEOUT_SECONDS=30
SQS_WAIT_TIME_SECONDS=10
SQS_RETRY_VISIBILITY_BACKOFF_SECONDS=5
SQS_MAX_RECEIVE_COUNT=5
SQS_MAX_MESSAGES=1

OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=20
OUTBOX_ENABLED=true
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_BACKOFF=1s
OUTBOX_CLAIM_LEASE=30s

REFERENCE_POLL_INTERVAL=1s
REFERENCE_MAX_ATTEMPTS=10
REFERENCE_BACKOFF=1s

# Logging

LOG_LEVEL=info
