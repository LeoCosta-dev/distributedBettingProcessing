# Application

APP_ENV=local
APP_NAME=distributedBettingProcessing
HTTP_ADDR=:8080

# PostgreSQL

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=wagering
POSTGRES_USER=wagering
POSTGRES_PASSWORD=wagering

DATABASE_URL=postgres://wagering:wagering@postgres:5432/wagering?sslmode=disable

# AWS / LocalStack

AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

SQS_WAGER_QUEUE=wager-transactions.fifo
SQS_WAGER_DLQ=wager-transactions-dlq.fifo

# Keycloak

KEYCLOAK_BASE_URL=http://keycloak:8080
KEYCLOAK_REALM=wagering
KEYCLOAK_ISSUER_URL=http://keycloak:8080/realms/wagering

# OAuth/OIDC

OAUTH_CLIENT_ID=wagering-api
OAUTH_CLIENT_SECRET=change-me

# Workers

SQS_VISIBILITY_TIMEOUT_SECONDS=30
SQS_MAX_RECEIVE_COUNT=5

OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=20

REFERENCE_POLL_INTERVAL=1s
REFERENCE_MAX_ATTEMPTS=10

# Logging

LOG_LEVEL=info
