{
  "realm": "wagering",
  "enabled": true,
  "roles": {
    "realm": [
      {
        "name": "provider",
        "description": "Wagering provider identity; scoped to its own transactions"
      },
      {
        "name": "internal",
        "description": "Internal wallet administration identity"
      }
    ]
  },
  "clients": [
    {
      "clientId": "wagering-api",
      "enabled": true,
      "publicClient": false,
      "secret": "change-me",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "provider-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "provider_id",
            "claim.name": "provider_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "wagering-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "wagering-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "provider-alpha",
      "enabled": true,
      "email": "provider-alpha@wagering.local",
      "emailVerified": true,
      "firstName": "Provider",
      "lastName": "Alpha",
      "attributes": {
        "provider_id": [
          "provider-alpha"
        ]
      },
      "realmRoles": [
        "provider"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "dev-only-pass",
          "temporary": false
        }
      ]
    },
    {
      "username": "provider-beta",
      "enabled": true,
      "email": "provider-beta@wagering.local",
      "emailVerified": true,
      "firstName": "Provider",
      "lastName": "Beta",
      "attributes": {
        "provider_id": [
          "provider-beta"
        ]
      },
      "realmRoles": [
        "provider"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "dev-only-pass",
          "temporary": false
        }
      ]
    },
    {
      "username": "wallet-admin",
      "enabled": true,
      "email": "wallet-admin@wagering.local",
      "emailVerified": true,
      "firstName": "Wallet",
      "lastName": "Admin",
      "realmRoles": [
        "internal"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "dev-only-pass",
          "temporary": false
        }
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"provider_id\",\"displayName\":\"${provider_id}\",\"validations\":{\"length\":{\"min\":1,\"max\":64}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  }
}
